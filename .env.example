# Public Production URL (used for dynamic QR code generation & SEO canonical links)
# Leave empty to automatically detect window.location.origin at runtime.
VITE_SITE_URL="https://your-reivon-vale-domain.vercel.app"

# Optional Supabase Deployment Configuration (for standalone Vercel + Supabase deployment)
# Safe public browser credentials only — NEVER place SUPABASE_SERVICE_ROLE_KEY in VITE_* variables!
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only secret (ONLY for server-side edge functions / scripts — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# Runtime App URL (auto-injected by hosting platform when applicable)
APP_URL=""
